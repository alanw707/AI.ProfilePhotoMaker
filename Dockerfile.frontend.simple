FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN echo '<html><head><title>AI Profile Photo Maker</title></head><body><h1>AI Profile Photo Maker Frontend</h1><p>Application is loading...</p><p>Backend API will handle photo processing.</p></body></html>' > /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]