{
  "rules": {
    // === HIGH IMPACT ERROR REDUCTION ===
    
    // 1. Naming Convention: Comprehensive exceptions for API & Angular patterns
    // Expected reduction: ~150-180 errors
    "@typescript-eslint/naming-convention": [
      "warn",
      {
        "selector": "default",
        "format": ["camelCase"]
      },
      {
        "selector": "variable",
        "format": ["camelCase", "UPPER_CASE"]
      },
      {
        "selector": "parameter",
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        // Constructor parameters (DI) - allow leading underscore
        "selector": "parameterProperty",
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        // Public class members - camelCase, no underscore required
        "selector": "classMethod",
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        // Public class properties - camelCase, no underscore required
        "selector": "classProperty",
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        // Private class members - allow leading underscore (relaxed)
        "selector": "memberLike",
        "modifiers": ["private"],
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "typeLike",
        "format": ["PascalCase"]
      },
      {
        "selector": "enumMember",
        "format": ["UPPER_CASE"]
      },
      {
        // TypeScript interface properties - API responses
        "selector": "typeProperty",
        "filter": {
          "regex": "^(id|created_at|updated_at|deleted_at|completed_at|user_id|profile_id|image_url|thumbnail_url|file_name|file_size|mime_type|status_code|error_code|request_id|session_id|access_token|refresh_token|expires_in|token_type|scope|state|code|redirect_uri|client_id|grant_type|response_type)$",
          "match": true
        },
        "format": null
      },
      {
        // API Response Properties - Object literals
        "selector": "objectLiteralProperty",
        "filter": {
          "regex": "^(id|created_at|updated_at|deleted_at|completed_at|user_id|profile_id|image_url|thumbnail_url|file_name|file_size|mime_type|status_code|error_code|request_id|session_id|access_token|refresh_token|expires_in|token_type|scope|state|code|redirect_uri|client_id|grant_type|response_type)$",
          "match": true
        },
        "format": null
      },
      {
        // HTTP Headers and Standard Web APIs
        "selector": "objectLiteralProperty", 
        "filter": {
          "regex": "^(Authorization|Content-Type|Accept|User-Agent|X-[A-Z][a-zA-Z-]*|ngrok-skip-browser-warning|Cache-Control|Last-Modified|ETag|If-None-Match|If-Modified-Since)$",
          "match": true
        },
        "format": null
      },
      {
        // CSS Properties and DOM attributes
        "selector": "objectLiteralProperty",
        "filter": {
          "regex": "^([a-z-]+|data-[a-z-]+|aria-[a-z-]+)$",
          "match": true  
        },
        "format": null
      }
    ],

    // 2. Unused Variables: Enhanced Angular exceptions
    // Expected reduction: ~30-40 errors
    "@typescript-eslint/no-unused-vars": [
      "warn", 
      { 
        "argsIgnorePattern": "^(_|unused|inject|provide|override)",
        "varsIgnorePattern": "^(_|unused|mock|Mock|WorkspaceState)",
        "caughtErrorsIgnorePattern": "^(_|ignored|error)",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],

    // 3. Complexity: Increase from 10→15 for realistic limits
    // Expected reduction: ~50-70 errors  
    "complexity": ["warn", { "max": 15 }],

    // === EXISTING RULES: Keep as warn ===
    "@angular-eslint/prefer-inject": "warn",
    "max-params": ["warn", { "max": 6 }], // Increase by 1 for DI
    "max-lines-per-function": ["warn", { "max": 75, "skipBlankLines": true, "skipComments": true }],
    "max-len": ["warn", { "code": 140, "ignoreUrls": true, "ignoreStrings": true, "ignoreTemplateLiterals": true }],
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "@typescript-eslint/explicit-function-return-type": "warn",
    "@angular-eslint/prefer-on-push-component-change-detection": "warn",

    // === ADDITIONAL PRAGMATIC ADJUSTMENTS ===
    "@typescript-eslint/no-explicit-any": "warn", // Keep as warn with context
    "@angular-eslint/template/use-track-by-function": "warn", // Performance hint, not blocker
    "max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-depth": ["warn", { "max": 5 }], // Increase from 4→5
    "@typescript-eslint/no-empty-function": "warn", // Reduce from error
    "@typescript-eslint/no-unsafe-function-type": "warn", // Reduce from error
    "@typescript-eslint/prefer-optional-chain": "warn", // Reduce from error
    
    // Import sorting - less strict for existing code
    "sort-imports": ["warn", {
      "ignoreCase": true,
      "ignoreDeclarationSort": true,
      "ignoreMemberSort": false,
      "memberSyntaxSortOrder": ["none", "all", "multiple", "single"]
    }]
  },
  
  "overrides": [
    {
      // Template-specific rules for HTML files
      "files": ["**/*.html"],
      "rules": {
        // === ACCESSIBILITY: Convert error→warn for existing code ===
        // Expected reduction: 48 errors
        "@angular-eslint/template/click-events-have-key-events": "warn",
        "@angular-eslint/template/interactive-supports-focus": "warn",
        
        // === TEMPLATE COMPLEXITY: Align with function complexity ===
        "@angular-eslint/template/cyclomatic-complexity": ["warn", { "maxComplexity": 15 }],
        "@angular-eslint/template/conditional-complexity": ["warn", { "maxComplexity": 5 }],
        "@angular-eslint/template/no-duplicate-attributes": "warn" // Reduce from error
      }
    },
    {
      // Test files - more relaxed rules
      "files": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-empty-function": "off",
        "max-lines-per-function": "off",
        "max-lines": "off",
        "complexity": "off"
      }
    }
  ]
}