{
  "name": "ai.profile-photo-maker.ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:test": "ng serve --host 0.0.0.0 --port 4200 --disable-host-check --configuration test",
    "start:ngrok": "ng serve --configuration ngrok --host 0.0.0.0 --disable-host-check",
    "ngrok": "ngrok http 4200 --domain=awlocaldev.ngrok.app",
    "build": "ng build",
    "build:test": "ng build --configuration test",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:integration": "ng test --karma-config=karma.integration.conf.js",
    "test:integration:headless": "ng test --karma-config=karma.integration.conf.js --watch=false --browsers=ChromeHeadless",
    "test:integration:watch": "ng test --karma-config=karma.integration.conf.js --watch=true",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "quality:check": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.4.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "face-api.js": "^0.22.2",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.12",
    "@angular/cli": "^19.2.12",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/jszip": "^3.4.0",
    "angular-eslint": "20.1.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.34.1"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write"
    ],
    "src/**/*.{html}": [
      "prettier --write"
    ],
    "src/**/*.{scss,css}": [
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
