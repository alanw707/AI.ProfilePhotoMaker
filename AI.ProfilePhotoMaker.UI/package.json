{
  "name": "ai.profile-photo-maker.ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "_comment_environments": "=== ENVIRONMENT-SPECIFIC SCRIPTS ===",
    "dev:local": "ng serve --configuration development --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "_comment_fullstack": "=== FULL-STACK DEVELOPMENT ===",
    "dev:fullstack:local": "concurrently \"npm run dev:local\" \"cd ../AI.ProfilePhotoMaker.API && dotnet run\"",
    "_comment_legacy": "=== LEGACY SCRIPTS (for compatibility) ===",
    "start": "npm run dev:local",
    "_comment_build": "=== BUILD SCRIPTS ===",
    "build": "npm run lint && ng build",
    "build:dev": "npm run lint && ng build --configuration development",
    "build:mvp-v1": "npm run lint && ng build --configuration mvp-v1",
    "build:prod": "npm run lint && ng build --configuration production",
    "_comment_testing": "=== TESTING SCRIPTS ===",
    "test": "ng test",
    "test:integration": "ng test --karma-config=karma.integration.conf.js",
    "test:integration:headless": "ng test --karma-config=karma.integration.conf.js --watch=false --browsers=ChromeHeadless",
    "test:integration:watch": "ng test --karma-config=karma.integration.conf.js --watch=true",
    "_comment_e2e": "=== E2E TESTING SCRIPTS ===",
    "test:e2e": "npx playwright test",
    "test:e2e:chrome": "npx playwright test --project=chromium",
    "test:e2e:mobile": "npx playwright test --project=mobile-chrome",
    "test:e2e:debug": "npx playwright test --debug",
    "playwright:install": "npx playwright install",
    "_comment_quality": "=== CODE QUALITY ===",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:errors-only": "ng lint --quiet",
    "lint:cache": "ng lint --cache",
    "lint:ci": "ng lint --quiet --cache --format json",
    "lint:changed": "lint-staged --no-push",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "quality:check": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "precommit": "lint-staged",
    "prepush": "npm run lint:errors-only",
    "_comment_utilities": "=== UTILITY SCRIPTS ===",
    "watch": "ng build --watch --configuration development",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "2.4.0",
    "@angular/animations": "^19.2.0",
    "@stripe/stripe-js": "^4.7.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "face-api.js": "^0.22.2",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.12",
    "@angular/cli": "^19.2.12",
    "@angular/compiler-cli": "^19.2.0",
    "@playwright/test": "^1.54.1",
    "@types/jasmine": "~5.1.0",
    "@types/jszip": "^3.4.0",
    "angular-eslint": "19.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "puppeteer": "^24.12.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.34.1"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.html": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{scss,css}": [
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}