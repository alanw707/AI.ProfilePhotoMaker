# AI Profile Photo Maker - Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values

# Application Configuration
app_name            = "aiprofilemaker"
environment         = "staging"
location           = "East US 2"
resource_group_name = "rg-aiprofilemaker-staging"

# Security Configuration (REQUIRED - Set these values)
sql_admin_password   = "YourSecurePassword123!"  # Min 8 chars, complex password
jwt_secret          = "your-super-secret-jwt-key-here-minimum-32-characters-long"
replicate_api_token = "r8_your_replicate_api_token_here"

# Cost Optimization Settings
enable_cost_optimization = true
sql_sku                 = "Basic"        # Basic, S0, S1, P1
container_registry_sku   = "Basic"       # Basic, Standard, Premium
storage_replication_type = "LRS"         # LRS, GRS, ZRS, GZRS

# Scaling Configuration
backend_min_replicas  = 0  # Scale to zero when not in use
backend_max_replicas  = 3  # Maximum concurrent instances
frontend_min_replicas = 0  # Scale to zero when not in use
frontend_max_replicas = 2  # Maximum concurrent instances

# Monitoring and Logging
log_analytics_retention_days = 30    # 30-730 days
enable_application_insights  = true

# Environment-specific examples:

# STAGING ENVIRONMENT (Cost-optimized)
# sql_sku                 = "Basic"     # ~$5/month
# container_registry_sku   = "Basic"     # ~$5/month
# storage_replication_type = "LRS"       # ~$2/month
# backend_min_replicas    = 0           # Scale to zero
# frontend_min_replicas   = 0           # Scale to zero
# log_analytics_retention_days = 30     # Minimum retention

# PRODUCTION ENVIRONMENT (Performance-optimized)
# sql_sku                 = "S1"        # ~$20/month
# container_registry_sku   = "Standard"  # ~$20/month
# storage_replication_type = "GRS"       # ~$4/month
# backend_min_replicas    = 1           # Always available
# frontend_min_replicas   = 1           # Always available
# log_analytics_retention_days = 90     # Extended retention