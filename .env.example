# Local development environment variables for AI Profile Photo Maker
# Populate sensitive values from Azure Key Vault via ./scripts/sync-secrets.sh
# Wrap in double quotes so special characters (like #) are preserved when docker-compose reads the file.
MSSQL_SA_PASSWORD=""
JWT_SECRET=
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
REPLICATE_OWNER=
REPLICATE_HARDWARE=gpu-h100
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=profile-images
APP_BASE_URL=http://localhost:4200
EXTERNAL_API_BASE_URL=http://localhost:5032
OAUTH_BASE_URL=http://localhost:5032
ENABLE_REPLICATE_MOCK=true
Email__PostmarkServerToken=
Test_Account=
Test_Account_Password=

OPENAI_API_KEY=""
