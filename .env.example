# =================================================================
# AI Profile Photo Maker - Environment Variables
# =================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env files with real secrets to version control
#
# Security Best Practices:
# - Use strong, unique passwords (minimum 16 characters)
# - Rotate secrets regularly (every 90 days for production)
# - Use Azure Key Vault or similar for production secrets
# - Enable environment variable validation on startup
# =================================================================

# =================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =================================================================

# Database Configuration
# =================================================================
# SQL Server SA password - REQUIRED for all environments
# Requirements: 8+ chars, mixed case, numbers, special chars
# Example: MyComplexP@ssw0rd2024!
MSSQL_SA_PASSWORD=YourSecurePassword123!

# Connection string template (auto-constructed using MSSQL_SA_PASSWORD)
# Override if you need custom connection parameters
# MSSQL_CONNECTION_STRING=custom_connection_string_here

# JWT Authentication Configuration
# =================================================================
# JWT Secret Key - REQUIRED for token signing/validation
# Requirements: Minimum 32 characters, cryptographically secure
# Generate with: openssl rand -base64 64
JWT_SECRET=YourSuperSecretJWTKeyAtLeast32CharactersLongGenerateWithOpenSSL

# JWT Token Configuration
# Valid audience - typically your frontend URL
JWT_VALID_AUDIENCE=http://localhost:4200
# Valid issuer - typically your API URL
JWT_VALID_ISSUER=http://localhost:5032

# AI/ML Service Configuration
# =================================================================
# Replicate API Token - REQUIRED for AI model access
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_actual_replicate_token_here

# Replicate Webhook Secret - REQUIRED for webhook validation
# Generate with: openssl rand -hex 32
REPLICATE_WEBHOOK_SECRET=your_webhook_secret_for_model_callbacks

# =================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =================================================================

# Application Environment
# =================================================================
# Options: Development, Test, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# Base URLs for different environments
APP_BASE_URL=http://localhost:4200

# Google OAuth Configuration (Optional)
# =================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Stripe Payment Configuration (Optional)
# =================================================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Azure Storage Configuration (Optional - defaults to local storage)
# =================================================================
# Azure Blob Storage connection string
# Get from Azure Portal -> Storage Account -> Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=myaccount;AccountKey=mykey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=profile-images

# Database Advanced Configuration
# =================================================================
# Database connection retry settings
DB_MAX_RETRY_COUNT=3
DB_MAX_RETRY_DELAY_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

# Enable detailed database logging (Development only)
DB_ENABLE_SENSITIVE_LOGGING=false
DB_ENABLE_DETAILED_ERRORS=true
DB_AUTO_MIGRATE_ON_STARTUP=true
DB_VALIDATE_ON_STARTUP=true

# Performance and Logging
# =================================================================
# Application performance settings
ENABLE_RESPONSE_COMPRESSION=true
ENABLE_REQUEST_LOGGING=false

# Logging levels: Trace, Debug, Information, Warning, Error, Critical
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_DATABASE=Debug

# Security Configuration
# =================================================================
# CORS allowed origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200

# Security headers and HTTPS settings
ENABLE_HTTPS_REDIRECT=false
REQUIRE_HTTPS_METADATA=false

# =================================================================
# DEPLOYMENT-SPECIFIC VARIABLES
# =================================================================

# Docker Configuration
# =================================================================
# Container port mappings
CONTAINER_API_PORT=5032
CONTAINER_DB_PORT=1433

# Health Check Configuration
# =================================================================
# Health check endpoints and timeouts
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=60

# =================================================================
# DEVELOPMENT HELPERS
# =================================================================

# Payment simulation for testing
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SKIP_STRIPE_INTEGRATION=true

# Model discovery and testing
MODEL_DISCOVERY_ENABLED=true
MODEL_POLLING_INTERVAL_SECONDS=30

# Background service intervals
RETENTION_POLICY_INTERVAL_HOURS=24
MODEL_EXPIRATION_CHECK_INTERVAL_HOURS=6

# =================================================================
# VALIDATION RULES (for reference)
# =================================================================
# MSSQL_SA_PASSWORD: Required, 8+ chars, complexity requirements
# JWT_SECRET: Required, 32+ chars, high entropy
# REPLICATE_API_TOKEN: Required, starts with 'r8_'
# REPLICATE_WEBHOOK_SECRET: Required, 32+ chars hex
# AZURE_STORAGE_CONNECTION_STRING: Optional, valid connection string format
# All URL variables: Optional, valid HTTP/HTTPS URLs
# Numeric variables: Valid integers within expected ranges
# Boolean variables: true/false values only
# =================================================================