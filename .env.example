# Environment Variables for AI Profile Photo Maker
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real secrets to version control

# Database Configuration
# Use a strong password for production deployments
DB_PASSWORD=YourSecurePassword123!

# JWT Configuration  
# Generate a cryptographically secure random string (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=YourSuperSecretJWTKeyAtLeast32CharactersLong

# Replicate API Configuration
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_actual_replicate_token_here

# Optional: Override other settings
# ASPNETCORE_ENVIRONMENT=Development
# AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string