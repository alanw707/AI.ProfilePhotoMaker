# Local development environment variables for AI Profile Photo Maker
# Populate sensitive values from Azure Key Vault via ./scripts/sync-secrets.sh
# Wrap in double quotes so special characters (like #) are preserved when docker-compose reads the file.
MSSQL_SA_PASSWORD=""
JWT_SECRET=
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
REPLICATE_OWNER=
REPLICATE_HARDWARE=gpu-h100
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=profile-images
APP_BASE_URL=http://localhost:4200
# Use localhost by default. Only point these at ngrok when you explicitly need external callbacks/webhooks.
EXTERNAL_API_BASE_URL=http://localhost:5032
OAUTH_BASE_URL=http://localhost:5032
ENABLE_REPLICATE_MOCK=true
Email__PostmarkServerToken=
Test_Account=
Test_Account_Password=

OPENAI_API_KEY=""
OPENAI__ApiKey=""
OPENAI__BaseUrl=https://api.openai.com/v1/
OPENAI__ImageEditEndpoint=images/edits
OPENAI__ImageModel=gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_HEADSHOT_MVP=true
PROFILE_PHOTO_WORKFLOW_OVERHAUL=true
OUTCOME_PACKAGES_VISIBLE=true
PROFILE_PHOTO_SCORE_VISIBLE=true
CREATIVE_STYLE_PACK_VISIBLE=true
PREMIUM_AUGMENTATIONS_VISIBLE=true
REPLICATE_TRAINING_FLOW_VISIBLE=false
Features__OpenAIHeadshotMvp=true
Features__ProfilePhotoWorkflowOverhaul=true
Features__OutcomePackagesVisible=true
Features__ProfilePhotoScoreVisible=true
Features__CreativeStylePackVisible=true
Features__PremiumAugmentationsVisible=true
Features__ReplicateTrainingFlowVisible=false
