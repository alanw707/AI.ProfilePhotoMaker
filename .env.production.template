# Production Environment Configuration Template
# Copy this file to .env.production and fill in the values

# Application Settings
ENVIRONMENT=production
ASPNETCORE_ENVIRONMENT=Production

# Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=5000
DB_PORT=1433
REDIS_PORT=6379
NGINX_PORT=8080
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# Database Configuration
DB_PASSWORD=YourStrong@Passw0rd
DB_CONNECTION_STRING=Server=db;Database=aiprofilephotomaker;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=true;

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production-make-it-very-long-and-random
JWT_AUDIENCE=http://localhost:80
JWT_ISSUER=http://localhost:5000

# External API Configuration
REPLICATE_API_TOKEN=your-replicate-api-token-from-replicate-com
REPLICATE_WEBHOOK_SECRET=your-webhook-secret-for-security

# Storage Configuration
AZURE_STORAGE_CONNECTION=UseDevelopmentStorage=true
REDIS_CONNECTION=redis:6379

# Application URLs
API_URL=http://localhost:5000/api
BASE_URL=http://localhost:5000

# Security Settings (for production deployment)
# HTTPS_REDIRECT=true
# SSL_CERT_PATH=/app/certs/cert.pem
# SSL_KEY_PATH=/app/certs/key.pem

# Resource Limits (optional)
# MEMORY_LIMIT=1g
# CPU_LIMIT=1.0