# =================================================================
# AI Profile Photo Maker - Production Environment
# =================================================================
# CRITICAL: This file contains production secrets
# Store securely using Azure Key Vault or similar secret management
# Never commit actual production values to version control
# =================================================================

# =================================================================
# REQUIRED PRODUCTION VARIABLES
# =================================================================

# Environment Configuration
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration (CRITICAL - USE STRONG PASSWORDS)
# Requirements: 16+ chars, mixed case, numbers, special chars
# Recommendation: Generate with password manager
MSSQL_SA_PASSWORD=YourProductionP@ssw0rd!ChangeThis2024

# JWT Configuration (CRITICAL - USE CRYPTOGRAPHICALLY SECURE SECRETS)
# Requirements: 64+ chars, high entropy, cryptographically secure
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_MINIMUM_64_CHARACTERS_CRYPTOGRAPHICALLY_SECURE
JWT_VALID_AUDIENCE=https://aiprofilephotomaker.com
JWT_VALID_ISSUER=https://api.aiprofilephotomaker.com

# AI/ML Services (PRODUCTION KEYS)
REPLICATE_API_TOKEN=r8_production_replicate_token_from_account_settings
REPLICATE_WEBHOOK_SECRET=production_webhook_secret_64_chars_minimum_cryptographically_secure

# =================================================================
# PRODUCTION CONFIGURATION
# =================================================================

# Application URLs
APP_BASE_URL=https://aiprofilephotomaker.com

# Database Settings (Production Tuned)
DB_MAX_RETRY_COUNT=5
DB_MAX_RETRY_DELAY_SECONDS=30
DB_COMMAND_TIMEOUT_SECONDS=60
DB_ENABLE_SENSITIVE_LOGGING=false
DB_ENABLE_DETAILED_ERRORS=false
DB_AUTO_MIGRATE_ON_STARTUP=false
DB_VALIDATE_ON_STARTUP=true

# Security Settings (PRODUCTION - SECURE)
ENABLE_HTTPS_REDIRECT=true
REQUIRE_HTTPS_METADATA=true
CORS_ALLOWED_ORIGINS=https://aiprofilephotomaker.com

# Performance Settings (Production Optimized)
ENABLE_RESPONSE_COMPRESSION=true
ENABLE_REQUEST_LOGGING=false

# Logging (Production - Minimal Verbosity)
LOG_LEVEL_DEFAULT=Warning
LOG_LEVEL_ASPNETCORE=Error
LOG_LEVEL_DATABASE=Warning

# Payment Configuration (LIVE MODE)
PAYMENT_SIMULATION_ENABLED=false
PAYMENT_SKIP_STRIPE_INTEGRATION=false

# =================================================================
# THIRD-PARTY INTEGRATIONS (PRODUCTION KEYS)
# =================================================================

# Google OAuth (Production Keys)
GOOGLE_CLIENT_ID=production_google_client_id_from_console
GOOGLE_CLIENT_SECRET=production_google_client_secret_secure

# Stripe Payment (LIVE KEYS - HANDLE WITH EXTREME CARE)
STRIPE_PUBLISHABLE_KEY=pk_live_production_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_production_stripe_secret_key_KEEP_SECURE
STRIPE_WEBHOOK_SECRET=whsec_production_stripe_webhook_secret

# Azure Storage (Production Account)
AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_PRODUCTION_AZURE_STORAGE_CONNECTION_STRING
AZURE_STORAGE_CONTAINER_NAME=profile-images

# =================================================================
# PRODUCTION MONITORING
# =================================================================

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=30

# Background Service Intervals (Production Tuned)
RETENTION_POLICY_INTERVAL_HOURS=24
MODEL_EXPIRATION_CHECK_INTERVAL_HOURS=4
MODEL_POLLING_INTERVAL_SECONDS=30

# =================================================================
# AZURE APP SERVICE CONFIGURATION
# =================================================================
# These variables are automatically configured by Azure App Service
# Override only if you need custom values

# Azure App Service Settings
# PORT=80
# WEBSITES_PORT=80
# WEBSITES_ENABLE_APP_SERVICE_STORAGE=false

# Azure App Service Health Checks
# WEBSITE_HEALTHCHECK_MAXPINGFAILURES=3
# WEBSITE_HEALTHCHECK_MAXUNHEALTHYWORKERPERCENT=50

# =================================================================
# SECURITY CONSIDERATIONS FOR PRODUCTION
# =================================================================
# 1. Use Azure Key Vault for all secrets
# 2. Enable Managed Identity for Azure resources
# 3. Rotate secrets every 90 days
# 4. Use different secrets for each environment
# 5. Monitor secret access and usage
# 6. Enable Azure Security Center recommendations
# 7. Use SSL/TLS certificates from trusted CA
# 8. Enable Application Insights for monitoring
# 9. Configure firewall rules for database access
# 10. Enable audit logging for all critical operations
# =================================================================

# =================================================================
# AZURE KEY VAULT INTEGRATION (RECOMMENDED)
# =================================================================
# Instead of storing secrets in environment variables,
# use Azure Key Vault references in Azure App Service:
#
# JWT_SECRET=@Microsoft.KeyVault(SecretUri=https://myvault.vault.azure.net/secrets/jwt-secret/)
# MSSQL_SA_PASSWORD=@Microsoft.KeyVault(SecretUri=https://myvault.vault.azure.net/secrets/db-password/)
# REPLICATE_API_TOKEN=@Microsoft.KeyVault(SecretUri=https://myvault.vault.azure.net/secrets/replicate-token/)
# STRIPE_SECRET_KEY=@Microsoft.KeyVault(SecretUri=https://myvault.vault.azure.net/secrets/stripe-secret/)
# =================================================================