# =================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =================================================================

# Database Configuration - Development SQL Server
MSSQL_SA_PASSWORD=Dev123456!
DATABASE_CONNECTION_STRING=Server=localhost,1433;Database=AIProfileMaker;User Id=sa;Password=Dev123456!;TrustServerCertificate=true;MultipleActiveResultSets=true;

# JWT Authentication Configuration - Development Keys
JWT_SECRET=DevJWTSecretKey1234567890123456789012345678901234567890Dev
JWT_VALID_AUDIENCE=http://localhost:4200
JWT_VALID_ISSUER=http://localhost:5032

# AI/ML Service Configuration - REAL API Token (Required for local testing)
REPLICATE_API_TOKEN=r8_FvCjahczdLfNmFTcDjhMzMuEuqKQswx2BxWD1
REPLICATE_WEBHOOK_SECRET=whsec_wUh0bvV+/jGsxbEqPsRgHI1tdct1Y+KM

# =================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =================================================================

# Environment Setting
ASPNETCORE_ENVIRONMENT=Development

# Application Base URL
APP_BASE_URL=http://localhost:4200

# Database Advanced Configuration
DB_MAX_RETRY_COUNT=3
DB_MAX_RETRY_DELAY_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30
DB_ENABLE_SENSITIVE_LOGGING=true
DB_ENABLE_DETAILED_ERRORS=true
DB_AUTO_MIGRATE_ON_STARTUP=true
DB_VALIDATE_ON_STARTUP=true

# Logging Configuration
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_DATABASE=Debug

# Development Payment Simulation
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SKIP_STRIPE_INTEGRATION=true

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200
ENABLE_HTTPS_REDIRECT=false
REQUIRE_HTTPS_METADATA=false

# =================================================================
# OPTIONAL DEVELOPMENT SERVICES (Can be empty for local testing)
# =================================================================

# Google OAuth (REQUIRED for local OAuth testing)
GOOGLE_CLIENT_ID=116968296687-fievkkqa9kdb2e3p1l11shh25bk751l4.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Stripe Payment (Optional - can be empty when payment simulation is enabled)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Azure Storage (Optional - will use local storage if empty)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=profile-images-dev

# =================================================================
# DEVELOPMENT HELPERS
# =================================================================

# Container Configuration
CONTAINER_API_PORT=5032
CONTAINER_DB_PORT=1433

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=60

# Performance Settings
ENABLE_RESPONSE_COMPRESSION=true
ENABLE_REQUEST_LOGGING=true

# Background Service Configuration
RETENTION_POLICY_INTERVAL_HOURS=24
MODEL_EXPIRATION_CHECK_INTERVAL_HOURS=6
MODEL_DISCOVERY_ENABLED=true
MODEL_POLLING_INTERVAL_SECONDS=30