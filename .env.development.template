# =================================================================
# REQUIRED VARIABLES FOR DEVELOPMENT
# =================================================================

# Database Configuration
MSSQL_SA_PASSWORD=Dev@P@ssw0rd123!
ASPNETCORE_ENVIRONMENT=Development

# JWT Configuration
JWT_SECRET=DevSecretKey123456789012345678901234567890ABCDEF
JWT_VALID_AUDIENCE=http://localhost:4200
JWT_VALID_ISSUER=http://localhost:5032

# AI/ML Services
REPLICATE_API_TOKEN=r8_your_development_replicate_token_here
REPLICATE_WEBHOOK_SECRET=dev_webhook_secret_123456789012345678901234567890ab

# =================================================================
# OPTIONAL DEVELOPMENT VARIABLES
# =================================================================

# Application URLs
APP_BASE_URL=http://localhost:4200

# Development Features
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SKIP_STRIPE_INTEGRATION=true
MODEL_DISCOVERY_ENABLED=true

# Database Settings
DB_ENABLE_SENSITIVE_LOGGING=false
DB_ENABLE_DETAILED_ERRORS=true
DB_AUTO_MIGRATE_ON_STARTUP=true
DB_VALIDATE_ON_STARTUP=true

# Logging
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_DATABASE=Debug

# Performance
ENABLE_RESPONSE_COMPRESSION=true
ENABLE_REQUEST_LOGGING=false

# Security (Development)
ENABLE_HTTPS_REDIRECT=false
REQUIRE_HTTPS_METADATA=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200

# =================================================================
# OPTIONAL THIRD-PARTY INTEGRATIONS
# =================================================================

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your_google_client_id_for_dev
# GOOGLE_CLIENT_SECRET=your_google_client_secret_for_dev

# Stripe Payment (Optional)
# STRIPE_PUBLISHABLE_KEY=pk_test_your_dev_stripe_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_dev_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_dev_stripe_webhook_secret

# Azure Storage (Optional - defaults to local storage)
