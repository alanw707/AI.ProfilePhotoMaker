# =================================================================
# TEST ENVIRONMENT CONFIGURATION
# =================================================================

# Application URLs
APP_BASE_URL=https://test.profilephotomaker.com

# Database Settings (More conservative for test)
DB_MAX_RETRY_COUNT=5
DB_MAX_RETRY_DELAY_SECONDS=30
DB_ENABLE_SENSITIVE_LOGGING=false
DB_ENABLE_DETAILED_ERRORS=false
DB_AUTO_MIGRATE_ON_STARTUP=false
DB_VALIDATE_ON_STARTUP=true

# Performance Settings
ENABLE_RESPONSE_COMPRESSION=true
ENABLE_REQUEST_LOGGING=true

# Security Settings
ENABLE_HTTPS_REDIRECT=true
REQUIRE_HTTPS_METADATA=true
CORS_ALLOWED_ORIGINS=https://test.profilephotomaker.com

# Logging (Less verbose for test)
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_DATABASE=Information

# Payment Configuration (Test Mode)
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SKIP_STRIPE_INTEGRATION=false

# =================================================================
# THIRD-PARTY INTEGRATIONS (TEST KEYS)
# =================================================================

# Google OAuth (Test Environment)
GOOGLE_CLIENT_ID=your_google_client_id_for_test
GOOGLE_CLIENT_SECRET=your_google_client_secret_for_test

# Stripe Payment (Test Keys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_test_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_stripe_webhook_secret

# Azure Storage (Test Environment)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=testaccount;AccountKey=testkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=profile-images-test

# =================================================================
# MONITORING AND HEALTH CHECKS
# =================================================================

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=60

# Background Service Intervals
RETENTION_POLICY_INTERVAL_HOURS=24
MODEL_EXPIRATION_CHECK_INTERVAL_HOURS=6
MODEL_POLLING_INTERVAL_SECONDS=60