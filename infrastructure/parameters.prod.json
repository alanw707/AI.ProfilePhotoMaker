{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "prod"
    },
    "namePrefix": {
      "value": "aiprofilephotomaker"
    },
    "appServicePlanSku": {
      "value": "B1"
    },
    "sqlAdminUsername": {
      "value": "aiprofileadmin"
    },
    "sqlAdminPassword": {
      "value": "REPLACE_WITH_PROD_SQL_PASSWORD"
    },
    "replicateApiToken": {
      "value": "REPLACE_WITH_REPLICATE_TOKEN"
    },
    "jwtSecret": {
      "value": "REPLACE_WITH_PROD_JWT_SECRET"
    },
    "replicateWebhookSecret": {
      "value": "REPLACE_WITH_WEBHOOK_SECRET"
    },
    "redisCacheSku": {
      "value": "Standard"
    },
    "redisCacheCapacity": {
      "value": 1
    },
    "enableContainerRegistry": {
      "value": true
    },
    "containerRegistrySku": {
      "value": "Standard"
    }
  }
}