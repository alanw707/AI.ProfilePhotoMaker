{
  "Monitoring": {
    "EnableDetailedLogging": true,
    "SlowRequestThresholdMs": 1000,
    "ExcludedPaths": [
      "/health",
      "/metrics",
      "/monitoring",
      "/swagger",
      "/favicon.ico",
      "/_framework",
      "/css",
      "/js",
      "/lib"
    ],
    "PerformanceThresholds": {
      "ApiResponseTimeWarningMs": 1000,
      "ApiResponseTimeCriticalMs": 5000,
      "ErrorRateWarningPercent": 5.0,
      "ErrorRateCriticalPercent": 15.0,
      "MemoryUsageWarningPercent": 80.0,
      "MemoryUsageCriticalPercent": 90.0,
      "CpuUsageWarningPercent": 70.0,
      "CpuUsageCriticalPercent": 85.0,
      "DatabaseQueryTimeWarningMs": 500,
      "DatabaseQueryTimeCriticalMs": 2000,
      "ThreadPoolUtilizationWarningPercent": 70.0,
      "ThreadPoolUtilizationCriticalPercent": 90.0
    },
    "MetricsRetention": {
      "ApiMetricsMaxEntries": 1000,
      "DatabaseMetricsMaxEntries": 500,
      "ExternalServiceMetricsMaxEntries": 200,
      "CustomMetricsMaxEntries": 1000,
      "MetricsRetentionHours": 24
    },
    "AlertingRules": {
      "CheckIntervalSeconds": 60,
      "AlertCooldownMinutes": 5,
      "MaxAlertsPerCategory": 10,
      "EnableEmailAlerts": false,
      "EnableSlackAlerts": false
    },
    "ApplicationInsights": {
      "EnableAdaptiveSampling": true,
      "EnableQuickPulseMetricStream": true,
      "EnableAuthenticationTracking": false,
      "SamplingPercentage": 100.0,
      "MaxTelemetryItemsPerSecond": 1000,
      "EnableSqlCommandTextInstrumentation": false,
      "EnableRedisInstrumentation": false
    },
    "HealthChecks": {
      "DatabaseTimeoutSeconds": 30,
      "StorageTimeoutSeconds": 15,
      "ExternalServiceTimeoutSeconds": 10,
      "HealthCheckCacheTtlSeconds": 30,
      "EnableDetailedHealthChecks": true
    },
    "Logging": {
      "StructuredLogging": true,
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "AI.ProfilePhotoMaker.API.Services.Monitoring": "Information",
        "AI.ProfilePhotoMaker.API.Middleware.PerformanceMonitoringMiddleware": "Information"
      },
      "Console": {
        "FormatterName": "json",
        "FormatterOptions": {
          "SingleLine": false,
          "IncludeScopes": true,
          "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
          "UseUtcTimestamp": true,
          "JsonWriterOptions": {
            "Indented": false
          }
        }
      },
      "ApplicationInsights": {
        "LogLevel": {
          "Default": "Information",
          "Microsoft": "Warning"
        }
      }
    }
  },
  "ConnectionStrings": {
    "ApplicationInsights": "InstrumentationKey=your-instrumentation-key-here;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/"
  },
  "Azure": {
    "ApplicationInsights": {
      "InstrumentationKey": "",
      "ConnectionString": "",
      "CloudRoleName": "AI.ProfilePhotoMaker.API",
      "CloudRoleInstance": "",
      "EnableLiveMetrics": true,
      "EnableAdaptiveSampling": true,
      "SamplingSettings": {
        "MaxTelemetryItemsPerSecond": 5,
        "EvaluationInterval": "00:00:15",
        "SamplingPercentageDecreaseTimeout": "00:02:00",
        "SamplingPercentageIncreaseTimeout": "00:15:00",
        "MovingAverageRatio": 0.25
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.ApplicationInsights" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentUserName"
    ],
    "Properties": {
      "Application": "AI.ProfilePhotoMaker.API",
      "Environment": "Development"
    }
  },
  "AspNetCore": {
    "HealthChecks": {
      "UI": {
        "HealthCheckDatabaseConnectionString": "",
        "EvaluationTimeInSeconds": 10,
        "MinimumSecondsBetweenFailureNotifications": 60,
        "MaximumHistoryEntriesPerEndpoint": 50
      }
    }
  }
}