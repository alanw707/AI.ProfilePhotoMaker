{
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_CONNECTION_STRING}",
    "AzureStorage": "UseDevelopmentStorage=true"
  },
  "JWT": {
    "ValidAudience": "http://localhost:4200",
    "ValidIssuer": "http://localhost:5032", 
    "Secret": "REPLACE_WITH_DEV_JWT_SECRET"
  },
  "Replicate": {
    "FluxTrainingModelId": "replicate/fast-flux-trainer:e65b43286cf1fc648ebac89c32149769637c0410f5346b97c251cdbc3fc3da1a",
    "FluxGenerationModelId": "black-forest-labs/flux-dev",
    "FluxKontextProModelId": "black-forest-labs/flux-kontext-pro"
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}",
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}"
  },
  "Authentication": {
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
    }
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "profile-images"
  },
  "PaymentSimulation": {
    "Enabled": true,
    "SkipStripeIntegration": true
  },
  "AppBaseUrl": "http://localhost:4200",
  "ExternalApiBaseUrl": "https://awlocaldev.ngrok-free.app",
  "Webhooks": {
    "NgrokTunnelUrl": "https://awlocaldev.ngrok-free.app",
    "BaseUrl": "",
    "NgrokApiUrl": "http://localhost:4040/api/tunnels"
  },
  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "AutoMigrateOnStartup": false,
    "ValidateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AI.ProfilePhotoMaker.API.Services.Database": "Debug"
    }
  },
  "AllowedHosts": "*"
}